{
  "name": "archie-sync",
  "version": "0.1.0",
  "description": "Sync a Google Doc containing ArchieML with local JSON files.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "archie-sync": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.15.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "test": "node --test test/*.test.ts"
  },
  "keywords": [
    "archieml",
    "google-docs",
    "i18n",
    "cms"
  ],
  "author": "Steven Loria",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sloria/archie-sync.git",
    "directory": "packages/archie-sync"
  },
  "dependencies": {
    "archieml": "^0.5.0",
    "gdoc-to-text": "^1.0.0",
    "google-auth-library": "^11.0.2"
  }
}
